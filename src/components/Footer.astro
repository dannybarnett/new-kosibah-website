---
import { site } from '../lib/site';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="ftr" data-compact={compact ? '' : undefined}>
  <div class="container">
    <p class="ftr__brand">KOSIBAH</p>
    {compact ? (
      <p class="ftr__line">{site.address.line1}, {site.address.line2} · <a href={`mailto:${site.email}`}>{site.email}</a></p>
    ) : (
      <div class="ftr__cols">
        <div>
          <p class="eyebrow">Atelier</p>
          <p>{site.address.line1}<br />{site.address.line2}</p>
        </div>
        <div>
          <p class="eyebrow">Appointments</p>
          <p><a href={site.phoneHref}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
      </div>
    )}
    {!compact && (
      <nav class="ftr__social" aria-label="Social">
        <a href={site.instagramUrl} rel="me noopener">Instagram</a>
        <a href={site.tiktokUrl} rel="me noopener">TikTok</a>
        <a href={site.pinterestUrl} rel="me noopener">Pinterest</a>
      </nav>
    )}
    <p class="ftr__legal">{compact ? '' : 'London 1991 · Harlem · '}© Kosibah {year} · <a href="/privacy">Privacy</a></p>
  </div>
</footer>

<style>
  .ftr { background: var(--ink); color: #cfcac2; padding-block: 3rem 2.5rem; }
  .ftr a { color: inherit; text-decoration: none; }
  .ftr a:hover { text-decoration: underline; }
  .ftr p { color: inherit; font-size: var(--text-sm); }
  .ftr__brand { font-family: var(--font-serif); font-size: 1.25rem; letter-spacing: 0.32em; color: var(--chalk); margin-bottom: 2rem; }
  .ftr .eyebrow { color: #8e8980; margin-bottom: 0.5rem; }
  .ftr__cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem; }
  .ftr__social { display: flex; gap: 1.5rem; margin-bottom: 2.5rem; }
  .ftr__social a { font-size: var(--text-xs); font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; min-height: var(--tap); display: inline-flex; align-items: center; }
  .ftr__legal { font-size: var(--text-xs); letter-spacing: 0.04em; color: #8e8980; margin: 0; }
  .ftr[data-compact] { padding-block: 2rem; }
  .ftr[data-compact] .ftr__brand { margin-bottom: 0.75rem; }
  .ftr__line { margin-bottom: 1rem; }
  @media (min-width: 768px) {
    .ftr__cols { grid-template-columns: repeat(2, minmax(0, 280px)); gap: 3rem; }
  }
</style>
