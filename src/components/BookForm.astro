---
/**
 * Step 1 of the booking flow: the one-minute qualifying form.
 * Posts to /api/lead (Cloudflare Pages Function). With JS, the page script
 * intercepts the submit, posts JSON and reveals Step 2 in place; without JS
 * the function answers with a 303 to /book#step-2.
 */
interface Props {
  action?: string;
}
const { action = '/api/lead' } = Astro.props;
---
<form
  id="lead-form"
  class="bform"
  action={action}
  method="post"
  novalidate
  aria-labelledby="step-1-label"
  aria-describedby="form-note"
>
  <div class="bform__head">
    <p class="eyebrow" id="step-1-label">Step 1 of 2</p>
    <p class="bform__time">About a minute</p>
  </div>

  <p id="form-note" class="bform__note" hidden role="status"></p>

  <div class="field">
    <label class="field__label" for="first-name">First name</label>
    <input class="field__input" id="first-name" name="firstName" type="text" autocomplete="given-name" required aria-describedby="err-first-name" />
    <p class="field__error" id="err-first-name" hidden>Please tell us your first name.</p>
  </div>

  <div class="field">
    <label class="field__label" for="email">Email</label>
    <input class="field__input" id="email" name="email" type="email" autocomplete="email" inputmode="email" required aria-describedby="err-email" />
    <p class="field__error" id="err-email" hidden>Please check your email address.</p>
  </div>

  <div class="field">
    <label class="field__label" for="phone">Phone or WhatsApp <span class="field__hint">(optional)</span></label>
    <input class="field__input" id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" aria-describedby="err-phone" />
    <p class="field__error" id="err-phone" hidden>Please check the number.</p>
  </div>

  <div class="field">
    <label class="field__label" for="wedding-date">Wedding date <span class="field__hint">(optional, roughly is fine)</span></label>
    <input class="field__input" id="wedding-date" name="weddingDate" type="text" placeholder="e.g. June 2027" autocomplete="off" />
  </div>

  <fieldset class="field field--seg">
    <legend class="field__label">Where shall we meet</legend>
    <div class="seg">
      <label class="seg__opt">
        <input type="radio" name="meeting" value="in-person" checked />
        <span>In person, Harlem</span>
      </label>
      <label class="seg__opt">
        <input type="radio" name="meeting" value="zoom" />
        <span>Over Zoom</span>
      </label>
    </div>
  </fieldset>

  <div class="field">
    <label class="field__label" for="notes">Tell Yemi about your day <span class="field__hint">(optional)</span></label>
    <textarea class="field__input field__input--area" id="notes" name="notes" rows="3" placeholder="The venue, the season, a gown you saw here, a tradition to honour"></textarea>
  </div>

  <div class="field field--consent">
    <label class="consent">
      <input type="checkbox" id="consent" name="consent" value="yes" required aria-describedby="err-consent" />
      <span>Kosibah may contact me about my consultation. Details are never shared. <a href="/privacy">Privacy policy.</a></span>
    </label>
    <p class="field__error" id="err-consent" hidden>Please tick the box so we can get in touch.</p>
  </div>

  <!-- Honeypot. Hidden from people; bots tend to fill it. -->
  <div class="bform__hp" aria-hidden="true">
    <label for="company">Company</label>
    <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <input type="hidden" name="utm_source" value="" />
  <input type="hidden" name="utm_medium" value="" />
  <input type="hidden" name="utm_campaign" value="" />
  <input type="hidden" name="gown" value="" />
  <input type="hidden" name="eventId" value="" />

  <button class="btn btn--book btn--block bform__submit" type="submit">Choose a time</button>
</form>

<style>
  .bform { display: grid; gap: 1.5rem; margin-block: 2.5rem 3rem; }
  .bform__head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .bform__head .eyebrow { margin: 0; }
  .bform__time { margin: 0; font-size: var(--text-sm); color: var(--ink-mute); }
  .bform__note { margin: 0; font-size: var(--text-sm); color: var(--ink-soft); border-left: 1px solid var(--ink); padding-left: 1rem; }

  .field { margin: 0; padding: 0; border: 0; min-width: 0; }
  .field__label {
    display: block; font-size: var(--text-xs); font-weight: 400; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--ink); margin: 0 0 0.6rem; padding: 0;
  }
  .field__hint { text-transform: none; letter-spacing: 0.02em; color: var(--ink-mute); font-size: var(--text-sm); }
  .field__input {
    display: block; width: 100%; min-height: 52px; padding: 0.75rem 1rem;
    font: inherit; font-size: var(--text-base); color: var(--ink); line-height: 1.4;
    background: var(--paper); border: 1px solid var(--line); border-radius: 0; appearance: none;
  }
  .field__input::placeholder { color: var(--ink-mute); opacity: 1; }
  .field__input:focus { outline: none; border-color: var(--ink); }
  .field__input:focus-visible { outline: 2px solid var(--oxblood); outline-offset: 2px; }
  .field__input[aria-invalid="true"] { border-color: var(--oxblood); }
  .field__input--area { min-height: 112px; resize: vertical; }
  .field__error { margin: 0.5rem 0 0; font-size: var(--text-sm); color: var(--oxblood); }

  /* Segmented toggle: two radios drawn as boxes */
  .seg { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .seg__opt {
    display: flex; align-items: center; gap: 0.75rem; min-height: 52px; padding: 0.75rem 1rem;
    background: var(--paper); border: 1px solid var(--line); cursor: pointer; font-size: var(--text-base);
    font-weight: 400; color: var(--ink);
  }
  .seg__opt input { width: 18px; height: 18px; margin: 0; flex: none; accent-color: var(--ink); }
  .seg__opt:has(input:checked) { border-color: var(--ink); box-shadow: inset 0 0 0 1px var(--ink); }
  .seg__opt:has(input:focus-visible) { outline: 2px solid var(--oxblood); outline-offset: 2px; }

  .consent { display: flex; gap: 0.75rem; align-items: flex-start; min-height: var(--tap); cursor: pointer; font-size: var(--text-sm); color: var(--ink-soft); line-height: 1.5; }
  .consent input { width: 18px; height: 18px; margin: 0.2rem 0 0; flex: none; accent-color: var(--ink); }
  .consent a { color: var(--ink); }
  .consent:has(input[aria-invalid="true"]) { color: var(--oxblood); }

  .bform__hp { position: absolute !important; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .bform__submit { margin-top: 0.5rem; }
  @media (max-width: 380px) { .seg { grid-template-columns: 1fr; } }
</style>
